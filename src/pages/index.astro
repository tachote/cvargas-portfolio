---
import Base from '../layouts/Base.astro';
import { cves } from '../data/cves.ts';
import ach from '../data/achievements.json';
import certs from '../data/certs.json';
import talks from '../data/talks.json';
import blogs from '../data/blogs.json';
const FEAT = ['e70b968b15c2', 'qyf-AlgEy20', 'd93394a4d719'];
const items = [
  ...blogs.map((b) => ({ kind: 'Post', title: b.title, url: b.url, year: b.year, lang: '' })),
  ...talks.map((t) => ({ kind: 'Talk', title: t.title, url: t.url, year: t.year, lang: 'ES' })),
];
const rank = (u: string) => { const i = FEAT.findIndex((f) => u.includes(f)); return i < 0 ? 99 : i; };
items.sort((a, b) => rank(a.url) - rank(b.url) || (b.year ?? 0) - (a.year ?? 0));
const ICO: Record<string,string> = { OSWE: '⚔', CWEE: '⛨', BSCP: '✠' };
const achTop = ach.filter((a) => a.tier === 'top');
const achRest = ach.filter((a) => a.tier !== 'top');
const topC = certs.filter((c) => c.tier === 'top');
const inv = certs.filter((c) => c.tier === 'other' && c.confirmed && !(c as any).hidden);
import notes from '../data/profile-notes.json';
const eng = (notes as any).english ?? certs.find((c) => c.tier === 'lang');
const TOP = 6, top = cves.slice(0, TOP), rest = cves.slice(TOP);
const cls = { Critical: 'crit', High: 'high', Medium: 'med', Low: 'low' };
---
<Base>
<div class="intro-ov" id="intro" aria-hidden="true"><div><img class="moon" src="/fx/moon.svg" alt="" width="96" height="96" /><div class="nm-wrap"><div class="nm">CRISTIAN VARGAS</div></div></div></div>
<div class="wrap">
<div class="topbar"><span>cvargas.com</span></div>
<header class="hero">
  <div class="sky" aria-hidden="true"><i class="l1"></i><i class="l2"></i><i class="l3"></i></div>
  <h1>Cristian Vargas <span class="moon">✝</span></h1>
  <p class="role"><b>Offensive Application Security Engineer @ Fluid Attacks</b> · Remote, Colombia</p>
  <p class="tagline">Finding vulnerabilities in software people depend on, like NestJS, Fastify, DOMPurify and Ghost.</p>
  <nav class="links"><a href="https://www.linkedin.com/in/cvmiracle">linkedin/cvmiracle</a><a href="#contact">contact</a></nav>
</header>

<section id="cves">
  <h2>CVEs &amp; Advisories <span class="amb">· Bestiary</span></h2>
  <p class="sub">Vulnerabilities found and disclosed. CVSS 4.0 severity shown as HP.</p>
  <div class="frame"><table>
    <thead><tr><th>ID</th><th>Product</th><th>Class</th><th>Severity</th></tr></thead>
    <tbody>
      {top.map(c => (
        <tr>
          <td class="id"><a href={c.advisory_url}>{c.id}</a>{c.co && <span class="co" title="Co-discovered">co-found</span>}</td>
          <td class="prod">{c.product}</td>
          <td class="cls-td cls">{c.detail ?? c.vuln_class}</td>
          <td class={`hp ${cls[c.severity] ?? 'med'}`} title={`${c.severity} · CVSS 4.0 ${c.cvss4}`}><span class="bar"><i style={`--w:${Math.round(c.cvss4 * 10)}%`}></i></span>{c.cvss4}{c.sprite && <img class="spr" src={`/fx/sprites/${c.sprite}.svg`} alt="" width="32" height="32" loading="lazy" />}</td>
        </tr>
      ))}
    </tbody>
  </table></div>
  {rest.length > 0 && (
  <details class="more"><summary>Show all {cves.length}</summary>
  <div class="frame"><table>
    <thead><tr><th>ID</th><th>Product</th><th>Class</th><th>Severity</th></tr></thead>
    <tbody>
      {rest.map(c => (
        <tr>
          <td class="id"><a href={c.advisory_url}>{c.id}</a>{c.co && <span class="co" title="Co-discovered">co-found</span>}</td>
          <td class="prod">{c.product}</td>
          <td class="cls-td cls">{c.detail ?? c.vuln_class}</td>
          <td class={`hp ${cls[c.severity] ?? 'med'}`} title={`${c.severity} · CVSS 4.0 ${c.cvss4}`}><span class="bar"><i style={`--w:${Math.round(c.cvss4 * 10)}%`}></i></span>{c.cvss4}{c.sprite && <img class="spr" src={`/fx/sprites/${c.sprite}.svg`} alt="" width="32" height="32" loading="lazy" />}</td>
        </tr>
      ))}
    </tbody>
  </table></div>
  </details>)}
</section>

<section id="awards">
  <h2>Awards <span class="amb">· Trophies</span></h2>
  <p class="sub">CTF and cyber competition results.</p>
  <div class="relics">
    {achTop.slice(0, 1).map((a) => (
      <div class="frame relic hero-relic"><div class="ico">{a.ico}</div><div><h3>{a.title}</h3><p>{a.detail}</p></div></div>
    ))}
  </div>
  <ul class="troph">
    {[...achTop.slice(1), ...achRest].map((a) => (
      <li class={a.tier === 'top' ? '' : 'lo'}><span class="ico">{a.ico}</span><b>{a.title}</b><span class="d">{a.detail}</span></li>
    ))}
  </ul>
</section>

<section id="writing">
  <h2>Writing &amp; Talks <span class="amb">· Grimoire</span></h2>
  <p class="sub">Research write-ups and conference talks.</p>
  <ul class="troph grim">
    {items.map((it) => (
      <li class={rank(it.url) < 99 ? '' : 'lo'}><span class="k">{it.kind}</span><a href={it.url} rel="noopener">{it.title}</a><span class="d">{it.lang && <span class="lang">{it.lang}</span>}{it.year ?? ''}</span></li>
    ))}
  </ul>
</section>

<section id="certifications">
  <h2>Certifications <span class="amb">· Relics</span></h2>
  <p class="sub">Offensive web and AppSec certifications.</p>
  <div class="relics">
    {topC.map((c) => (
      <div class="frame relic"><div class="ico">{ICO[c.name] ?? '✦'}</div><div><h3>{c.verify_url ? <a href={c.verify_url}>{c.name}</a> : c.name}</h3><p>{c.full.replace(/\s*\([^)]*\)$/, '')}{c.year ? ` · ${c.year}` : ''}</p></div></div>
    ))}
  </div>
  <p class="inv-h">Inventory · {inv.length} more</p>
  <ul class="inv">
    {inv.map((c) => (
      <li title={c.full}>{c.verify_url ? <a href={c.verify_url}>{c.name}</a> : c.name}</li>
    ))}
  </ul>
</section>

<section id="contact">
  <h2>Contact <span class="amb">· Save Room</span></h2>
  <p class="sub">Open to remote AppSec / offensive security roles.</p>
  <div class="frame contact">
    <div><span>email</span><a href="#">(pending)</a></div>
    <div><span>linkedin</span><a href="https://www.linkedin.com/in/cvmiracle">cvmiracle</a></div>
    {eng && <div><span>english</span>{eng.verify_url ? <a href={eng.verify_url}>C2 · {eng.issuer}</a> : `C2 · ${eng.issuer}`}</div>}
    <div><span>github</span><a href="#">(pending)</a></div>
  </div>
</section>

<footer><span>© 2026 Cristian Vargas</span><a href="/play/">↑↑↓↓←→←→BA</a></footer>
</div>
<script>
  const k = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a']; let i = 0;
  addEventListener('keydown', e => { i = e.key === k[i] ? i + 1 : (e.key === k[0] ? 1 : 0); if (i === k.length) location.href = '/play/'; });
  const ov = document.getElementById('intro');
  const skip = () => ov.classList.add('gone');
  ['keydown', 'pointerdown', 'wheel', 'touchstart'].forEach(ev => addEventListener(ev, skip, { once: true, passive: true }));
  ov.addEventListener('animationend', e => { if (e.animationName === 'ov-out') skip(); });
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ls = [...document.querySelectorAll('.sky i')], f = [0.1, 0.25, 0.4], mxr = [0, 8, 14]; let tx = 0, cx = 0, raf = 0;
    const draw = () => { raf = 0; cx += (tx - cx) * 0.08; const y = scrollY; ls.forEach((l, j) => l.style.transform = `translate3d(${cx * mxr[j]}px, ${y * f[j]}px, 0)`); if (Math.abs(tx - cx) > 0.001) q(); };
    const q = () => { if (!raf) raf = requestAnimationFrame(draw); };
    addEventListener('scroll', q, { passive: true });
    if (matchMedia('(pointer: fine)').matches) addEventListener('pointermove', e => { tx = (e.clientX / innerWidth - .5) * 2; q(); }, { passive: true });
    if (!matchMedia('(hover: hover)').matches) {
      const io = new IntersectionObserver(es => es.forEach(en => { if (en.isIntersecting) { en.target.classList.add('hit'); io.unobserve(en.target); } }), { threshold: .6 });
      document.querySelectorAll('tbody tr').forEach(r => io.observe(r));
    }
  }
</script>
</Base>
