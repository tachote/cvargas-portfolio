---
import Base from '../layouts/Base.astro';
---
<Base title="404 · Cristian Vargas" description="This room is empty." robots="noindex">
  <main class="wrap lost">
    <section class="save-room" aria-labelledby="lost-title">
      <img class="lost-spr" src="/fx/sprites/idor.svg" alt="" width="64" height="64" decoding="async" />
      <p class="eyebrow">404 · Lost in the castle</p>
      <h1 id="lost-title">This room is empty</h1>
      <p class="sub">The door you opened leads nowhere. Whatever lived here has moved on.</p>
      <a class="button primary" href="/">← Back to the castle</a>
    </section>
  </main>
</Base>
