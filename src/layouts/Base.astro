---
import '../styles.css';
import '../fx.css';
import site from '../data/site.json';
const { title = `${site.name} · Offensive AppSec`, description = `${site.role} at ${site.company}. CVEs, advisories and offensive security research.`, robots } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="gothic">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {robots && <meta name="robots" content={robots} />}
<title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#0E0A12" />
  <link rel="preload" href="/fonts/Inter.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

</head>
<body id="top" itemscope itemtype="https://schema.org/Person">
  <meta itemprop="name" content={site.name} />
  <meta itemprop="jobTitle" content={site.role} />
  <link itemprop="url" href="https://cvargas.com/" />
  <link itemprop="sameAs" href={site.linkedin} />
  <link itemprop="sameAs" href={site.github} />
  <slot />
</body>
</html>
